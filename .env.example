# Oracle Readiness MCP — environment variables
# Copy to .env and adjust before running docker-compose up

# ── MCP HTTP server ───────────────────────────────────────────────────────────
READINESS_HTTP_PORT=8080

# Optional Bearer token. If set, clients must send:
#   Authorization: Bearer <READINESS_TOKEN>
# Leave blank to disable auth (suitable for local/private network use only).
READINESS_TOKEN=

# ── Refresh schedule ──────────────────────────────────────────────────────────
# How often (in hours) to re-scrape Oracle readiness pages
READINESS_REFRESH_HOURS=6

# Set to "0" to disable the background refresh loop (use scheduler.py via cron instead)
READINESS_AUTOSTART_REFRESH=1
